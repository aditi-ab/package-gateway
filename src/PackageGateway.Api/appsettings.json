{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=/data/packagegateway.db"
  },
  "BlobStorage": {
    "Path": "/data/blobs"
  },
  "Authentication": {
    "Mode": "Local",
    "DataProtectionKeysPath": "/data/dataprotection-keys",
    "DocumentationUrl": "/docs/"
  },
  "Gateway": {
    "TokenPepper": "",
    "VulnerabilityRescanInterval": "12:00:00",
    "BackgroundJobLeaseDuration": "00:30:00",
    "OriginIntegrityInterval": "12:00:00"
  },
  "Security": {
    "MaximumPackageBytes": 262144000,
    "MaximumExpandedBytes": 1073741824,
    "MaximumFileBytes": 104857600,
    "MaximumFileCount": 10000,
    "MaximumCompressionRatio": 200,
    "ScanTimeout": "00:05:00",
    "InitialRequestWait": "00:01:30",
    "VulnerabilityCacheMaximumAge": "1.00:00:00",
    "BlockedSha256Digests": []
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*"
}
