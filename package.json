{
  "name": "secure-package-gateway",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": ["src/PackageGateway.Admin", "documentation"],
  "resolutions": {
    "eslint-plugin-jsdoc": "62.8.0",
    "eslint-plugin-regexp": "3.1.0"
  },
  "scripts": {
    "build": "yarn build:admin && yarn build:docs",
    "build:ui": "yarn --cwd Packages/Aditify build",
    "build:admin": "yarn build:ui && yarn workspace package-gateway-admin build",
    "build:docs": "yarn workspace package-gateway-docs build",
    "test": "yarn --cwd Packages/Aditify test && yarn workspace package-gateway-admin test"
  }
}
